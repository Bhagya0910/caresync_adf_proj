{
	"name": "PL_SOURCE_TO_SILVER",
	"properties": {
		"activities": [
			{
				"name": "Read source table list",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_id from ctrl.table_config where is_active=1 and source_system = '@{pipeline().parameters.source_system}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Ds_AzureSqldatabase",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ingest all tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read source table list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read source table list').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "ingeston source to silver",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Insert In Progress Status",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SOURCE_TO_SILVER_INNER",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_id": {
										"value": "@item().table_id",
										"type": "Expression"
									},
									"adf_run_id": {
										"value": "@pipeline().parameters.adf_run_id",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Insert In Progress Status",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "Ls_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "insert into ctrl.audit_log(adf_run_id, table_id, stage, status, start_time)\nVALUES('@{pipeline().parameters.adf_run_id}',@{item().table_id}, 'SOURCE_TO_SILVER','IN_PROGRESS', SYSUTCDATETIME());",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Update Failed Status",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "ingeston source to silver",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "Ls_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.audit_log\nSET status = 'FAILED', end_time= SYSUTCDATETIME()\nWHERE adf_run_id= '@{pipeline().parameters.adf_run_id}' AND table_id= @{item().table_id};",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"source_system": {
				"type": "string"
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a4"
			}
		},
		"variables": {
			"test": {
				"type": "String"
			}
		},
		"annotations": []
	}
}